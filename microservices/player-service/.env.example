# Service Configuration
SERVICE_NAME=player-service
SERVICE_HOST=localhost
SERVICE_PORT=3009
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=player_db
DB_USER=postgres
DB_PASSWORD=password
DB_SYNC=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here

# Player data export encryption (replace with a unique secret of at least 32 bytes)
EXPORT_ENCRYPTION_KEY=replace-this-with-a-random-secret-at-least-32-bytes

# SMTP delivery for on-demand and scheduled exports
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EXPORT_EMAIL_FROM=player-service@example.com

LOG_LEVEL=log